{
  "name": "@moon/sdk",
  "version": "0.2.0",
  "description": "Moon SDK for portable applications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "moon": "bin/moon.mjs"
  },
  "files": [
    "dist",
    "bin",
    "DATABASES.md",
    "COMPATIBILITY.md",
    "SYNC.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node bin/check-syntax.mjs && npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "ajv": "^8.20.0",
    "firebase": "^12.18.0",
    "jsonc-parser": "3.3.1",
    "mysql2": "^3.24.3",
    "pg": "^8.23.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "vite": "8.2.2"
  }
}
