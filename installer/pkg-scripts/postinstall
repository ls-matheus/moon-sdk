#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022
exec >>/var/log/moon-sdk-installer.log 2>&1
echo "--- Moon SDK installer $(date) ---"
trap 'echo "Falha na linha $LINENO (status $?)"' ERR
[ "${3:-/}" = / ] || { echo "Selecione o disco de inicialização."; exit 1; }
scripts="$(cd "$(dirname "$0")" && pwd)"
mkdir -p /usr/local/lib/moon-sdk/releases /usr/local/bin /etc/paths.d
release="$(mktemp -d /usr/local/lib/moon-sdk/releases/install.XXXXXX)"
/bin/bash "$scripts/install-runtime.sh" "$release" "$scripts/moon-sdk.tgz"
chmod 755 "$release"
ln -sfn "$release" /usr/local/lib/moon-sdk/current
cat > "$release/moon-launcher" <<'LAUNCHER'
#!/bin/bash
export PATH="/usr/local/lib/moon-sdk/current/bin:$PATH"
exec /usr/local/lib/moon-sdk/current/bin/node /usr/local/lib/moon-sdk/current/lib/node_modules/@moon/sdk/bin/moon.mjs "$@"
LAUNCHER
chmod 755 "$release/moon-launcher"
mv -f "$release/moon-launcher" /usr/local/bin/moon
printf '%s\n' /usr/local/lib/moon-sdk/current/bin /usr/local/bin > /etc/paths.d/moon-sdk
chmod 644 /etc/paths.d/moon-sdk
for command in node npm npx; do
  if [ ! -e "/usr/local/bin/$command" ] && [ ! -L "/usr/local/bin/$command" ]; then
    ln -s "/usr/local/lib/moon-sdk/current/bin/$command" "/usr/local/bin/$command"
  fi
done
/usr/local/bin/moon --help
echo "Instalação concluída."
